# ===========================================
# Santé Numérique Niger - Configuration
# ===========================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# -------------------------------
# Base de données PostgreSQL
# -------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@host:5432/database?schema=public"

# -------------------------------
# NextAuth (Authentification)
# -------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="votre-secret-nextauth-très-long-et-aléatoire-min-32-caractères"

# -------------------------------
# Chiffrement des champs sensibles
# -------------------------------
# 32 caractères hexadécimaux (16 bytes)
ENCRYPTION_KEY="votre-cle-chiffrement-32-caracteres-hex"

# -------------------------------
# Email SMTP (notifications)
# -------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@sante-numerique.ne"
SMTP_PASSWORD="mot-de-passe-smtp"
EMAIL_FROM="Santé Numérique Niger <noreply@sante-numerique.ne>"

# -------------------------------
# SMS (alertes, invitations)
# -------------------------------
# Fournisseurs locaux : Orange Niger, Moov Africa Niger
SMS_PROVIDER="orange"
SMS_API_KEY="votre-cle-api-sms"
SMS_SENDER_ID="SanteNum"

# -------------------------------
# Stockage fichiers (exports PDF, images)
# -------------------------------
S3_ENDPOINT="https://s3.fr-par.scw.cloud"
S3_REGION="fr-par"
S3_BUCKET="sante-numerique-documents"
S3_ACCESS_KEY="votre-access-key"
S3_SECRET_KEY="votre-secret-key"

# -------------------------------
# Monitoring & Observabilité
# -------------------------------
SENTRY_DSN="https://xxx@sentry.io/xxx"
VERCEL_ANALYTICS_ID="xxx"

# -------------------------------
# Intégration DHIS2 (optionnel)
# -------------------------------
DHIS2_URL="https://dhis2.sante.gov.ne"
DHIS2_USERNAME="api_user"
DHIS2_PASSWORD="mot-de-passe-api"

# -------------------------------
# Parameters feature
# -------------------------------
ENABLE_PWA="true"
ENABLE_OFFLINE="true"
ENABLE_2FA="true"
ENABLE_DHIS2_SYNC="false"

# -------------------------------
# Production secrets (NE jamais mettre dans Git)
# -------------------------------
# DATABASE_URL, NEXTAUTH_SECRET, ENCRYPTION_KEY, SMTP_PASSWORD,
# S3_ACCESS_KEY, S3_SECRET_KEY, SENTRY_DSN, DHIS2_PASSWORD